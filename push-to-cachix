#!/usr/bin/env bash
set -euo pipefail

CACHE="re-cache"

pkgs2push=(
  quickshell
  opencode
  xdg-desktop-portal-kde
  ncro
  millennium
  protondb
  protondb-status
  size-on-disk
  open-design
  qt6ct
  proton-cachyos-slr-bin
)

pattern=$(IFS=\|; echo "${pkgs2push[*]}")

nix path-info --recursive /run/current-system \
  | grep -E "^/nix/store/[a-z0-9]{32}-(${pattern})(-wrapped)?-" \
  | grep -v -E "(\.(json|conf|toml|service|md)|-config)$" \
  | cachix push "$CACHE"
